{
  "name": "@pacyfist/veneer",
  "version": "0.0.2",
  "description": "Angular directives that scramble text in the DOM and render it correctly with a font generated at runtime, so scrapers, scripts and copy-paste get gibberish.",
  "keywords": [
    "angular",
    "angular-library",
    "ssr",
    "anti-scraping",
    "scraping",
    "web-scraping",
    "ai-crawlers",
    "ai-scraping",
    "content-protection",
    "text-obfuscation",
    "obfuscation",
    "copy-protection",
    "font",
    "opentype",
    "cmap"
  ],
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pacyfist/veneer.git",
    "directory": "projects/pacyfist/veneer"
  },
  "homepage": "https://pacyfist.github.io/veneer/",
  "bugs": {
    "url": "https://github.com/pacyfist/veneer/issues"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
