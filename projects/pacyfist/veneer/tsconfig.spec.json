/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/spec",
    "types": ["vitest/globals", "node"],
    // Specs compile against the library sources, not dist/, so a spec and the
    // entry points it imports share one copy of every class and DI token.
    "paths": {
      "@pacyfist/veneer": ["./src/public-api.ts"],
      "@pacyfist/veneer/core": ["./core/src/public-api.ts"],
      "@pacyfist/veneer/forge": ["./forge/src/public-api.ts"],
      "@pacyfist/veneer/server": ["./server/src/public-api.ts"],
      "@pacyfist/veneer/testing": ["./testing/src/public-api.ts"]
    }
  },
  "include": ["**/src/**/*.d.ts", "**/src/**/*.spec.ts"]
}
