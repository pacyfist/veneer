{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "basic-ssr": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ssr",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "outputMode": "server",
            "ssr": { "entry": "src/server.ts" },
            "security": { "allowedHosts": ["localhost", "127.0.0.1"] }
          },
          "configurations": {
            "zoneless": {
              "outputPath": "dist/zoneless",
              "polyfills": [],
              "fileReplacements": [
                { "replace": "src/app/app.config.ts", "with": "src/app/app.config.zoneless.ts" }
              ]
            },
            "csr": {
              "outputPath": "dist/csr",
              "server": false,
              "ssr": false,
              "outputMode": "static",
              "fileReplacements": [
                { "replace": "src/app/app.config.ts", "with": "src/app/app.config.csr.ts" }
              ]
            }
          }
        }
      }
    }
  }
}
