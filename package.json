{
  "name": "veneer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:lib": "ng build @pacyfist/veneer && node -e \"require('fs').copyFileSync('LICENSE', 'dist/pacyfist/veneer/LICENSE')\"",
    "build": "npm run build:lib && ng build demo",
    "start": "npm run build:lib && ng serve demo --port 4321",
    "watch": "ng build demo --watch --configuration development",
    "test": "npm run build:lib && ng test @pacyfist/veneer --watch=false",
    "build:pages": "npm run build:lib && ng build demo --configuration production,github-pages",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "serve:ssr:demo": "node dist/demo/server/server.mjs"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.20",
    "@tailwindcss/postcss": "^4.3.3",
    "express": "^5.1.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/opentype.js": "^1.3.10",
    "daisyui": "^5.7.16",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
