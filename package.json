{
  "name": "veneer-workspace",
  "private": true,
  "description": "Workspace for @pacyfist/veneer and its demo site. Not published; the library version lives in projects/pacyfist/veneer/package.json.",
  "scripts": {
    "ng": "ng",
    "build:lib": "ng build @pacyfist/veneer && node -e \"const fs = require('fs'); fs.copyFileSync('LICENSE', 'dist/pacyfist/veneer/LICENSE'); fs.copyFileSync('projects/pacyfist/veneer/CHANGELOG.md', 'dist/pacyfist/veneer/CHANGELOG.md')\"",
    "size": "node scripts/check-bundle-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "api:check": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --update",
    "example:smoke": "node scripts/example-smoke.mjs",
    "build": "npm run build:lib && node scripts/demo-veneer-fonts.mjs clean && ng build demo && node scripts/demo-veneer-fonts.mjs copy",
    "start": "npm run build:lib && ng serve demo --port 4321",
    "watch": "ng build demo --watch --configuration development",
    "test": "npm run build:lib && ng test @pacyfist/veneer --watch=false",
    "test:node-core": "npm run build:lib && node scripts/node-core-smoke.mjs",
    "build:pages": "npm run build:lib && node scripts/demo-veneer-fonts.mjs clean && ng build demo --configuration production,github-pages && node scripts/demo-veneer-fonts.mjs copy",
    "use-angular": "node scripts/use-angular.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "serve:ssr:demo": "node dist/demo/server/server.mjs",
    "format:check": "prettier --check ."
  },
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.20",
    "@tailwindcss/postcss": "^4.3.3",
    "express": "^5.1.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/opentype.js": "^1.3.10",
    "daisyui": "^5.7.47",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.25",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
